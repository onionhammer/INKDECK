# Copy to .env (gitignored) and fill in. Read at build time by scripts/gen_secrets.py.
# Wi-Fi, TIMEZONE, LATITUDE and LONGITUDE can also be set on the card in SD:/inkdeck.ini, which
# wins (src/settings.h). The board keeps them for updates from GitHub, whose images have none.
# One KEY=VALUE per line; no inline comments (passwords may contain '#').
# Optional: without WIFI_SSID the firmware builds with no network. Environment variables of
# the same name override this file.

WIFI_SSID=
# Leave empty for an open network.
WIFI_PASSWORD=

# Time zone as a POSIX TZ string, daylight-saving rule included (the ESP32 can't read IANA names
# like America/Chicago). Empty means UTC. US Central below; US Eastern EST5EDT,M3.2.0,M11.1.0,
# Mountain MST7MDT,M3.2.0,M11.1.0, Arizona MST7, Pacific PST8PDT,M3.2.0,M11.1.0,
# UK GMT0BST,M3.5.0/1,M10.5.0. Any zone: https://github.com/nayarsystems/posix_tz_db (zones.csv)
TIMEZONE=CST6CDT,M3.2.0,M11.1.0

# Where you are, in decimal degrees (north and east positive), for sunrise and sunset on the
# Clock and for the Weather forecast. Optional, but set both or neither. Two decimals (about a
# kilometre) are plenty. The values are compiled into the firmware like the rest of this file.
LATITUDE=
LONGITUDE=

