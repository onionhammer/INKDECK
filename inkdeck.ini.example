; INKDECK settings. Copy to the root of the microSD card as inkdeck.ini.
; A value here overrides the one built into the firmware from .env. The board reads this file
; when it starts. If the card has no inkdeck.ini, the board writes one with every line
; commented out.
; Comments start with ; or #. Delete a line, or put ; in front of it, to use the built-in value.
; Passwords don't stay in this file, since a card is easy to lift: the board keeps each one and
; rewrites its line (a password line becomes a note; an smb line loses its :password).
; Parser and rules: src/settings.h.

[wifi]
; The Wi-Fi networks to join, instead of the one built into the firmware from .env: up to 8,
; each an ssid line with its password line under it. The board tries the network it last
; joined first, then the others in the order listed here. With no password line, an open
; network (or the password the board kept for that ssid). Remove the ssid lines to go back to
; the built-in network.
ssid = HomeNet
password = correct horse battery staple
ssid = Phone hotspot
password = another passphrase

[clock]
; The time zone as a POSIX TZ string, which includes the daylight saving rule. The ESP32 can't
; read IANA names like Europe/London.
;   EST5EDT,M3.2.0,M11.1.0      US Eastern
;   CST6CDT,M3.2.0,M11.1.0      US Central
;   MST7MDT,M3.2.0,M11.1.0      US Mountain
;   MST7                        Arizona
;   PST8PDT,M3.2.0,M11.1.0      US Pacific
;   GMT0BST,M3.5.0/1,M10.5.0    UK
;   CET-1CEST,M3.5.0,M10.5.0/3  Central Europe
; Any zone: https://github.com/nayarsystems/posix_tz_db (zones.csv)
timezone = GMT0BST,M3.5.0/1,M10.5.0

[location]
; Where sunrise, sunset and the weather forecast are for, in decimal degrees (north and east
; positive; two decimals is about a kilometre). Set both or neither.
latitude = 51.48
longitude = 0.00

[network]
; Shares to browse in Files, up to 4 smb and nfs lines in all, read-only.
;
; SMB (Windows, Samba, most NAS boxes), SMB2 or SMB3 with a user name and password:
;   smb = smb://[domain;]user:password@server[:port]/share[/folder]
; The board keeps the password and takes it out of the line. In the password, write
; @ : / ? ; % as %40 %3A %2F %3F %3B %25. A folder after the share opens Files there.
;
; NFS version 3 over TCP, with no password: nfs://server/export or server:/export.
;   uid, gid   who the server takes the board for (default 0, which many servers map to
;              nobody: give your own user's numbers if the files aren't readable by everyone)
;   nfsport    the server's NFS port, also written nfs://server:2049/export
;   mountport  its MOUNT port
; Without the ports the server's portmapper says (port 111), as it does on most NAS boxes.
; The server must export the folder to the board's address, over NFS v3 and TCP.
;
; Options go after a ?, joined by &. Both take name, what Files calls the share (else the last
; folder of its path).
smb = smb://erik:secret@192.168.1.20/share/media?name=Media
nfs = nfs://nas.local/volume1/books

[lock]
; A PIN of 4 to 8 digits locks the board when it powers on, and when it wakes from the desk
; face. The firmware can be built to ask for it on opening System or Files instead, or as well
; (INKDECK_PIN_ON). Turn the wheel to pick each digit, then press for the next, like a padlock.
; System > PIN LOCK sets, changes and clears it on the board as well. The board keeps the
; PIN and replaces this line with a note, so the PIN doesn't stay on the card. To change it
; here, write a new pin = line. To remove it, write pin = off. Either change takes effect
; once you unlock with the current PIN.
; pin = 2468
; Also lock after this many minutes without a key (0: only at power-on). Power-on builds only.
; lock_minutes = 5

[voice]
; The machine on your network that runs inkharness, the assistant daemon (a name or an
; address), its port (7391 unless you changed it) and the token in its inkharness.toml. The
; token never leaves this file: it keys the connection's encryption, so make it long and random
; (openssl rand -hex 24). With [tailscale] set, voice_host can be the machine's name on your
; tailnet (macbook, macbook.tail1234.ts.net) or its 100.x address, and the board reaches it
; from any Wi-Fi. A name is tried on your LAN first, so at home the board doesn't join.
; voice_host = nas.local
; voice_port = 7391
; voice_token = something-long

[tailscale]
; Puts the board on your tailnet when something needs a machine there: a voice_host, a share's
; server or a feed's host given as a tailnet name or 100.x address. Wi-Fi Drive and Update
; over Wi-Fi answer on the tailnet too while they're open. Make an auth key in Tailscale's
; admin console (Settings > Keys), reusable and not ephemeral: the board is offline most of
; the time, and Tailscale removes an ephemeral machine soon after it goes. Once the board shows
; up in Machines, turn off its key expiry there. The board keeps the key and replaces this
; line with a note; a different key joins it as a new machine. tailscale_key = off removes it.
; tailscale_key = tskey-auth-k1234567CNTRL-abcdefghijklmnopqrstuvwxyz
; Its name on the tailnet: letters, digits and hyphens (inkdeck unless you change it).
; tailscale_name = inkdeck
