{
  "name": "microlink",
  "version": "2.3.0+1cb8d1c",
  "description": "Tailscale client for the ESP32 by CamM2325 (control protocol, WireGuard as an lwIP interface, DISCO, DERP), vendored for the tailnet (src/tailnet.h). See README.md.",
  "license": "MIT AND BSD-3-Clause",
  "frameworks": "*",
  "platforms": "espressif32",
  "build": {
    "srcDir": ".",
    "includeDir": "include",
    "srcFilter": [
      "-<*>",
      "+<src/*.c>",
      "+<wireguard/src/wireguard.c>",
      "+<wireguard/src/wireguardif.c>",
      "+<wireguard/src/wireguard-filter.c>",
      "+<wireguard/src/crypto.c>",
      "+<wireguard/src/wireguard-platform-esp32.c>",
      "+<wireguard/src/crypto/refc/*.c>",
      "+<port/*.c>"
    ],
    "flags": [
      "-Iport",
      "-include microlink_kconfig.h",
      "-Iinclude",
      "-Isrc",
      "-Iwireguard/src",
      "-Iwireguard/src/crypto/refc",
      "-DWIREGUARD_CRYPTO_REFC=1",
      "-w"
    ],
    "libArchive": true
  }
}
