# inkharness configuration. Copy to inkharness.toml in a folder, or to ~/.config/inkharness to
# use it from any folder (a folder's own file is layered over that one), then run
# `inkharness serve` (the daemon for boards) or plain `inkharness` (a chat in the terminal).
# API keys are read from the environment or a .env file, never from this file.

listen = "0.0.0.0:7391"         # boards connect here
http = "127.0.0.1:7392"         # the HTTP API (POST /chat); "" turns it off
# Boards encrypt the connection with this token (voice_token in SD:/inkdeck.ini, the same on
# both ends; it never crosses the network), and HTTP requests send it as a bearer token. Make it
# long and random: openssl rand -hex 24. Empty: anyone who can reach the ports may use them.
token = ""
# plaintext = true      # also take boards on firmware from before encryption (protocol 1),
                        # which send the token and the audio unencrypted
# system_prompt = "..."   # replaces the built-in ones (for spoken and for written replies)

# --- Speech to text --------------------------------------------------------------------
# Any server with OpenAI's /audio/transcriptions: a hosted service, or locally Speaches,
# whisper.cpp's whisper-server, mlx-audio. Moving to local hardware is a base_url change.
[stt]
backend = "openai_compat"
base_url = "https://api.openai.com/v1"
model = "REPLACE_ME"            # the service's current transcription model
api_key_env = "OPENAI_API_KEY"  # unset or empty: no Authorization header (local servers)
# language = "en"

# --- Language model --------------------------------------------------------------------
[llm]
backend = "anthropic"
model = "claude-opus-5-5"       # claude-haiku-5-5 is the one to compare for first-token time
effort = "low"                  # thinking depth: low answers soonest
api_key_env = "ANTHROPIC_API_KEY"
fallbacks = true                # re-run a declined request on a fallback model; set false for Haiku

# Or any server with OpenAI's /chat/completions (Ollama, llama.cpp, vLLM):
# [llm]
# backend = "openai_compat"
# base_url = "http://localhost:11434/v1"
# model = "qwen3.6:27b"

# --- Text to speech --------------------------------------------------------------------
# Any server with OpenAI's /audio/speech that can return raw PCM (response_format "pcm"):
# a hosted service, or locally Kokoro-FastAPI, Speaches, mlx-audio.
[tts]
backend = "openai_compat"
base_url = "https://api.openai.com/v1"
model = "REPLACE_ME"            # the service's current speech model
voice = "REPLACE_ME"
rate = 24000                    # sample rate of the PCM the service returns
api_key_env = "OPENAI_API_KEY"

# --- Home control ----------------------------------------------------------------------
# Without this section the model has no tools and only talks.
# [home_assistant]
# url = "http://homeassistant.local:8123"
# token_env = "HOME_ASSISTANT_TOKEN"            # a long-lived access token
# play_service = "music_assistant.play_media"   # the action play_music calls

# --- Thinking harder (optional) -------------------------------------------------------
# The model above gets a think_harder tool. When it calls it, one of the phrases is said and
# this model answers instead, with the same conversation and tools.
# [think]
# phrases = ["Let me think about that.", "Give me a moment to think.", "Hmm, let me think."]
#
# [think.llm]
# backend = "anthropic"
# model = "claude-opus-5-5"
# effort = "medium"
# api_key_env = "ANTHROPIC_API_KEY"

# --- Text turns (optional) -------------------------------------------------------------
# The terminal chat and the HTTP API use [llm]. A model that speaks is still asked for its audio
# there (OpenAI's audio models answer text only that way) and only its transcript is shown; a
# text model here is cheaper and quicker for them.
# [chat.llm]
# backend = "anthropic"
# model = "claude-opus-5-5"
# effort = "low"
# api_key_env = "ANTHROPIC_API_KEY"

# --- Speech cache ----------------------------------------------------------------------
# Short sentences (up to 80 characters) are kept as audio and replayed without a request;
# the phrases under think and these are synthesised at startup. On by default.
# [cache]
# tts_entries = 200             # 0 turns it off
# phrases = ["Done.", "Sorry, I didn't catch that."]

# --- JavaScript sandbox ----------------------------------------------------------------
# The run_js tool: the model writes and runs JavaScript for arithmetic and dates, or to chain
# home tools (tools.list_speakers(), tools.play_music({...})) in one step. QuickJS, with no
# network, files or timers. On by default.
# [js]
# enabled = true
# timeout_ms = 3000             # tool calls included
# memory_mb = 32
# max_tool_calls = 20           # home tool calls per script

# --- MCP servers -----------------------------------------------------------------------
# Each server's tools join the models' tools as <name>_<tool>, and run_js scripts can call
# them too. A server that can't be reached at startup is logged and left out. A .mcp.json in
# the folder inkharness starts in (or in ~/.config/inkharness) adds its mcpServers, in the
# format other agents use, with ${VAR} from the environment and .env.
#
# Home Assistant: /api/mcp/assist is device control, limited to the entities exposed to voice
# assistants (Settings > Voice assistants > Expose). A long-lived access token is expected to
# work as the bearer token; check with one request before relying on it.
# [[mcp]]
# name = "home"
# url = "http://homeassistant.local:8123/api/mcp/assist"
# token_env = "HOME_ASSISTANT_TOKEN"
# tools = ["HassTurnOn", "HassTurnOff", "HassLightSet"]   # optional allowlist; unset: all
# timeout_ms = 20000
# talk = true                 # false: talk turns (HOLD BOOT outside the Agent) don't get its tools
#
# A local server started as a command (stdio). cargo build --release --example mcp_demo
# builds a small demo one.
# [[mcp]]
# name = "demo"
# command = "target/release/examples/mcp_demo"
# args = []
# env = { }
# cwd = "."                   # the folder it runs in, from this file's; unset: where inkharness started

# --- Web search ------------------------------------------------------------------------
# The web_search tool, for what the models don't know or what has changed: news, scores,
# opening hours. [search] for one backend; [[search]] for several, tried in order until one
# answers (the next is asked when one fails or finds nothing). results: how many (default 5).
#
# SearXNG, a metasearch engine you run yourself: free, no key, nothing leaves your network but
# the query to its engines. Its settings.yml must allow json (search: formats: [html, json]).
# [search]
# backend = "searxng"
# url = "http://searxng.local:8080"
# language = "en"            # optional
# engines = "brave,duckduckgo"   # optional; unset: the instance's defaults
#
# Brave's Search API (its own index; a key from api-search.brave.com):
# [[search]]
# backend = "brave"
# api_key_env = "BRAVE_API_KEY"
# country = "us"             # optional
#
# Tavily, a search API for agents: each search comes with a short answer written from the
# results (a key from tavily.com):
# [[search]]
# backend = "tavily"
# api_key_env = "TAVILY_API_KEY"
# depth = "basic"            # or "advanced": better snippets, slower, costs more

# --- Skills ----------------------------------------------------------------------------
# Agent Skills: a folder per skill with a SKILL.md (name and description between --- lines,
# then instructions). The models see each skill's name and description, and load the
# instructions with load_skill when a request matches; read_skill_file reads its other files.
# skills/goodnight is an example. Found without any setting in skills/, .agents/skills/ and
# .claude/skills/ of the folder inkharness starts in, and in ~/.config/inkharness/skills/;
# dirs adds others.
# [skills]
# dirs = ["../shared-skills"]   # relative to this file

# --- Slash commands --------------------------------------------------------------------
# Prompts kept as markdown files, typed as /name in text turns (the terminal, HTTP), as Claude
# Code keeps them: commands/play.md is /play, with $ARGUMENTS for what follows. Found
# without any setting in commands/, .agents/commands/ and .claude/commands/ of the folder
# inkharness starts in, and in ~/.config/inkharness/commands/; dirs adds others. Every skill is
# a command too (/goodnight).
# [commands]
# dirs = ["../shared-commands"]   # relative to this file

# --- Agent sessions --------------------------------------------------------------------
# Tasks that live on the daemon, are kept on disk and go on working with no board connected:
# a board starts one by talking on its Agent screen, follows its plan and log, and answers its
# questions; programs do the same over HTTP (/sessions). Sessions run on [agent.llm] if it is
# there, else [chat.llm], else [llm], with the tools above plus plan and ask_choice. Without
# this section there are none, and boards talk as before.
# [agent]
# dir = "sessions"            # where they are kept, relative to this file
# place = "ONIONSERVE"        # the name boards show for where they run; default: the host's name
# pin_sha256 = "..."          # optional: printf %s 1234 | sha256sum. A board must unlock with the
#                             # PIN (HTTP sends X-Inkharness-Pin) before it sees or does anything
#                             # with sessions; the token alone is on the board's card
# ticket_minutes = 60         # how long an unlock lets the board's new connections back in
# keep_days = 30              # finished sessions older than this are deleted
# max_rounds = 40             # model rounds per run before a session fails ("too many steps")
# reply = "spoken"            # an agent turn's reply: "spoken", a sentence or two; "none", no
#                             # reply (the words are written down and go to the session, the
#                             # board hears which session took them)
#
# The model sessions run on, any [llm] backend: a text model that is good with tools, as a
# session works through many steps on its own. Through OpenRouter:
# [agent.llm]
# backend = "openai_compat"
# base_url = "https://openrouter.ai/api/v1"
# model = "anthropic/claude-haiku-5.5"
# api_key_env = "OPENROUTER_API_KEY"
# reasoning = "low"           # optional, as under [llm]
#
# What new sessions run on: "api" (the model above), "claude" (Claude Code, [agent.claude]) or
# "herdr" (a program in a new herdr terminal, [herdr] default_program).
# backend = "api"
#
# Claude Code in print mode, one run per session. It pays with ANTHROPIC_API_KEY if that is set
# (here in the environment or the .env), else with the subscription `claude` is logged in with.
# [agent.claude]
# command = ["claude"]
# model = ""                  # --model; empty: Claude Code's default
# permission_mode = "default"
# allowed_tools = ["Read", "Grep", "Glob", "WebSearch", "WebFetch"]
# disallowed_tools = []
# dir = "work"                # each session works in <dir>/<id>, relative to this file
# max_turns = 40
# herdr = false               # true, with [herdr] below: a new session starts as Claude Code in a
#                             # herdr terminal (same model, permission mode and tools, a new folder
#                             # under dir), where it can be watched and taken over; the board
#                             # follows it as a herdr session. Hidden as before when herdr can't
#                             # start it. Trust dir in Claude Code once (run claude there)
#
# The api backend's own tools (Claude Code has its own). Files live in <[agent] dir>/work/<id>
# and go with the session.
# [agent.tools]
# files = true                # read_file, write_file, list_files
# http = "allow"              # http_fetch: pages and APIs on the internet
# http_private = false        # true: it may reach loopback, LAN and tailnet addresses too
# shell = "deny"              # "allow": sh -c in the work folder, as the daemon's user
# shell_timeout_s = 60

# --- herdr -----------------------------------------------------------------------------
# Programs in herdr terminals (Claude Code, Codex, a shell…), here or on other herdr machines,
# as sessions of their own, followed through `hc connect`. With an [agent] table.
# [herdr]
# command = ["hc"]            # or ["ssh", "box", "hc"]
# machines = []               # whose terminals count; empty: all
# programs = []               # which programs count; empty: any that reports a status
# run = "allow"               # herdr_run, [agent] backend = "herdr", [agent.claude] herdr = true
# answer = "allow"            # press the keys of a question's choice
# send = "allow"              # type words into it
# interrupt = "deny"          # press its stop key
# kill = "deny"               # end its program
# templates = { claude = ["claude"], codex = ["codex", "--no-daemon"] }
# default_program = "claude"
# default_machine = ""

# --- Talk ------------------------------------------------------------------------------
# What a talk turn (HOLD BOOT outside the Agent, and every board from before sessions) may
# use: tool names, or prefixes ending in *. The board's own tools always stay. Unset: every
# tool. Talk turns never see the sessions, whatever this says; their one way in is
# propose_job, which files a job for someone behind the PIN to start (list it, or leave it
# out of `tools` to keep talk from filing any).
# [talk]
# tools = ["run_js", "web_search", "think_harder", "home_*"]
